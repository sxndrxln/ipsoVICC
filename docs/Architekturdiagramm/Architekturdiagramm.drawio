        <mxCell id="footA" parent="1" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.0;fontColor=#1A202C;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=13;fontStyle=0;" value="&lt;b&gt;Ablauf A · Betriebssicht&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A1&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Client löst die Domain über Cloudflare-DNS auf und sendet die HTTPS-Anfrage&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A2&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Cloudflare leitet den Verkehr (proxied) an den Reverse Proxy weiter&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A3&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Reverse Proxy (TLS) leitet an Traefik im k3s-Cluster weiter&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A4&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Traefik wertet die Ingress-Regel aus&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A5&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Ingress verweist auf den Service&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A6&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Service leitet an den Web-Pod (Web-UI / REST-API) weiter&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A7&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Web-Pod greift auf die Daten im PVC zu&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A8&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;CronJob-Pod erhält Konfiguration (ConfigMap) und Zugangsdaten (Secret)&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A9&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;CronJob-Pod gleicht das Inventar per API-Abfrage mit der NVD ab&lt;br&gt;&lt;font color=&quot;#2B6CB0&quot;&gt;&lt;b&gt;A10&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;CronJob-Pod speichert die Ergebnisse im PVC&lt;br&gt;" vertex="1">
          <mxGeometry height="260" width="900" x="10" y="925" as="geometry" />
        </mxCell>
        <mxCell id="footB" parent="1" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1.0;fontColor=#1A202C;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=13;fontStyle=0;" value="&lt;b&gt;Ablauf B · Bereitstellungssicht&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;B1&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Ansible erstellt die VM auf dem Proxmox-Host&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;B2&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Ansible installiert und konfiguriert k3s auf der VM&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;B3&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Ein Release im Repository startet die GitHub-Actions-Pipeline&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;B4&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;GitHub Actions baut das Docker-Image und pusht es zu Docker Hub&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;B5&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;Terraform stellt die Kubernetes-Ressourcen über die Kubernetes-API bereit&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;B6&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;k3s zieht das Image von Docker Hub&lt;br&gt;" vertex="1">
          <mxGeometry height="260" width="790" x="920" y="925" as="geometry" />
        </mxCell>
